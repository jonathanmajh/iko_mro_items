# Local dev overrides for EAM Spare Parts.
# Copy to `.env` (gitignored) and adjust. `.env.local` (also gitignored)
# optionally overrides `.env` per machine. Real environment variables always
# win. Production defaults apply when nothing is set — see assets/constants.js.

# Maximo environment hostname (default: prod.manage.prod.iko.max-it-eam.com)
# MAXIMO_ENV=mas.manage.uat.ikona-np.naviam.app

# Open DevTools on launch (default: false)
# OPEN_DEV_TOOLS=true

# Firebase usage-tracking config (defaults target the iko-reliability project)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=iko-reliability.firebaseapp.com
# FIREBASE_PROJECT_ID=iko-reliability
# FIREBASE_STORAGE_BUCKET=iko-reliability.appspot.com
# FIREBASE_MESSAGING_SENDER_ID=36956740284
# FIREBASE_APP_ID=1:36956740284:web:561e9a73a0f3f4b08fceb9
# FIREBASE_MEASUREMENT_ID=G-112KCDJT5G
